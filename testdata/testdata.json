  "bogonResponse": {
    "why": "A bogon is answered locally in the full max shape. Every flag is present and false, every detail object is present and empty, and is_bogon marks it as computed rather than served.",
    "flagsFalse": [
      "is_vpn",
      "is_hosting",
      "is_relay",
      "is_tor",
      "is_cdn",
      "is_resproxy",
      "is_dcproxy",
      "is_mobproxy"
    ],
    "emptyObjects": [
      "vpn",
      "hosting",
      "relay",
      "tor",
      "cdn",
      "resproxy",
      "dcproxy",
      "mobproxy"
    ]
  },
  "lookup": [
    {
      "name": "free-not-vpn",
      "why": "The free shape. Every tier-gated member is absent, which means not-in-your-plan and must not read as false.",
      "status": 200,
      "body": {
        "ip": "1.1.1.1",
        "is_vpn": false
      },
      "expect": {
        "ip": "1.1.1.1",
        "isBogon": false,
        "present": {
          "is_vpn": false
        },
        "absent": [
          "is_hosting",
          "is_relay",
          "is_tor",
          "is_cdn",
          "is_resproxy",
          "is_dcproxy",
          "is_mobproxy",
          "vpn",
          "hosting",
          "relay",
          "tor",
          "cdn",
          "resproxy",
          "dcproxy",
          "mobproxy"
        ]
      }
    },
    {
      "name": "starter-vpn-hit",
      "why": "Starter buys the vpn object and the four classification FLAGS, but none of their detail objects.",
      "status": 200,
      "body": {
        "ip": "45.83.91.1",
        "is_vpn": true,
        "is_hosting": true,
        "is_relay": false,
        "is_tor": false,
        "is_cdn": false,
        "vpn": {
          "provider": "mullvad",
          "last_seen": "2026-09-02"
        }
      },
      "expect": {
        "ip": "45.83.91.1",
        "isBogon": false,
        "present": {
          "is_vpn": true,
          "is_hosting": true,
          "is_relay": false
        },
        "absent": [
          "is_resproxy",
          "is_dcproxy",
          "is_mobproxy",
          "hosting",
          "relay",
          "tor",
          "cdn",
          "resproxy",
          "dcproxy",
          "mobproxy"
        ],
        "vpn": {
          "provider": "mullvad",
          "last_seen": "2026-09-02"
        }
      }
    },
    {
      "name": "scale-empty-object-means-flag-false",
      "why": "An empty detail object beside a false flag means not-found. It must not be confused with an absent member.",
      "status": 200,
      "body": {
        "ip": "8.8.8.8",
        "is_vpn": false,
        "is_hosting": true,
        "is_relay": false,
        "is_tor": false,
        "is_cdn": false,
        "vpn": {},
        "hosting": {
          "provider": "Google",
          "confidence": "high",
          "last_seen": "2026-09-02"
        },
        "relay": {},
        "tor": {},
        "cdn": {}
      },
      "expect": {
        "ip": "8.8.8.8",
        "isBogon": false,
        "present": {
          "is_vpn": false,
          "is_hosting": true,
          "is_tor": false
        },
        "absent": [
          "is_resproxy",
          "is_dcproxy",
          "is_mobproxy",
          "resproxy",
          "dcproxy",
          "mobproxy"
        ],
        "emptyPresent": [
          "vpn",
          "relay",
          "tor",
          "cdn"
        ],
        "hosting": {
          "provider": "Google",
          "confidence": "high",
          "last_seen": "2026-09-02"
        }
      }
    },
    {
      "name": "max-full-shape",
      "why": "Max adds confidence and method on vpn, plus the three proxy families.",
      "status": 200,
      "body": {
        "ip": "45.83.91.1",
        "is_vpn": true,
        "is_hosting": true,
        "is_relay": false,
        "is_tor": false,
        "is_cdn": false,
        "is_resproxy": false,
        "is_dcproxy": true,
        "is_mobproxy": false,
        "vpn": {
          "provider": "mullvad",
          "last_seen": "2026-09-02",
          "confidence": "high",
          "method": "openvpn_cert"
        },
        "hosting": {
          "provider": "M247",
          "confidence": "high",
          "last_seen": "2026-09-02"
        },
        "relay": {},
        "tor": {},
        "cdn": {},
        "resproxy": {},
        "dcproxy": {
          "provider": "brightdata",
          "first_seen": "2026-06-14",
          "last_seen": "2026-09-02",
          "hits": 42,
          "hits_days_pct": 63,
          "providers_num": 2
        },
        "mobproxy": {}
      },
      "expect": {
        "ip": "45.83.91.1",
        "isBogon": false,
        "present": {
          "is_vpn": true,
          "is_dcproxy": true,
          "is_resproxy": false
        },
        "absent": [],
        "vpn": {
          "provider": "mullvad",
          "last_seen": "2026-09-02",
          "confidence": "high",
          "method": "openvpn_cert"
        },
        "dcproxy": {
          "provider": "brightdata",
          "first_seen": "2026-06-14",
          "last_seen": "2026-09-02",
          "hits": 42,
          "hits_days_pct": 63,
          "providers_num": 2
        }
      }
    },
    {
      "name": "unattributed-range-keeps-empty-provider",
      "why": "A populated object always carries every key. An unattributed range has an empty provider string, never a missing one.",
      "status": 200,
      "body": {
        "ip": "185.199.1.1",
        "is_vpn": true,
        "vpn": {
          "provider": "",
          "last_seen": "2026-08-30"
        }
      },
      "expect": {
        "ip": "185.199.1.1",
        "isBogon": false,
        "present": {
          "is_vpn": true
        },
        "vpn": {
          "provider": "",
          "last_seen": "2026-08-30"
        }
      }
    }
  ],
  "errors": [
    {
      "name": "invalid-ip",
      "status": 400,
      "headers": {},
      "body": {
        "error": "not a valid IP address"
      },
      "expect": {
        "kind": "bad_request",
        "retryable": false,
        "message": "not a valid IP address"
      }
    },
    {
      "name": "invalid-key",
      "status": 401,
      "headers": {},
      "body": {
        "error": "invalid API key"
      },
      "expect": {
        "kind": "unauthorized",
        "retryable": false,
        "message": "invalid API key"
      }
    },
    {
      "name": "cidr-restricted",
      "status": 403,
      "headers": {},
      "body": {
        "error": "source address not allowed for this API key"
      },
      "expect": {
        "kind": "forbidden",
        "retryable": false
      }
    },
    {
      "name": "not-found-is-not-retryable",
      "why": "A 404 is a CLIENT error. Falling through to the server_error default makes it retryable, so a bad dataset id is retried before it fails. Only 5xx and transport failures are retryable.",
      "status": 404,
      "headers": {},
      "body": {
        "rc": "NOT_FOUND"
      },
      "expect": {
        "kind": "bad_request",
        "retryable": false
      }
    },
    {
      "name": "rate-limited-is-retryable",
      "why": "Retry-After present. This is the API protecting itself and retrying WILL succeed.",
      "status": 429,
      "headers": {
        "Retry-After": "1"
      },
      "body": {
        "error": "rate limit exceeded"
      },
      "expect": {
        "kind": "rate_limited",
        "retryable": true,
        "retryAfterSeconds": 1
      }
    },
    {
      "name": "keyless-daily-quota-is-not-retryable",
      "why": "No Retry-After. The keyless daily allowance is spent and retrying will not help.",
      "status": 429,
      "headers": {},
      "body": {
        "error": "daily limit for unauthenticated requests exceeded; use an API key"
      },
      "expect": {
        "kind": "quota_exceeded",
        "retryable": false
      }
    },
    {
      "name": "plan-quota-is-not-retryable",
      "status": 429,
      "headers": {},
      "body": {
        "error": "request allowance exceeded; raise or remove your overage limit"
      },
      "expect": {
        "kind": "quota_exceeded",
        "retryable": false
      }
    },
    {
      "name": "server-error-is-retryable",
      "status": 500,
      "headers": {},
      "body": {
        "error": "lookup failed"
      },
      "expect": {
        "kind": "server_error",
        "retryable": true
      }
    }
  ],
  "batch": [
    {
      "name": "dedup-bogon-and-order-free-keying",
      "why": "Duplicates collapse to one request, bogons never reach the network, and the result is keyed by IP so input order stops mattering.",
      "input": [
        "1.1.1.1",
        "8.8.8.8",
        "1.1.1.1",
        "10.0.0.1",
        "192.168.1.1"
      ],
      "expect": {
        "keys": [
          "1.1.1.1",
          "8.8.8.8",
          "10.0.0.1",
          "192.168.1.1"
        ],
        "httpRequests": 2,
        "bogonKeys": [
          "10.0.0.1",
          "192.168.1.1"
        ]
      }
    },
    {
      "name": "partial-failure-does-not-fail-the-batch",
      "why": "One address erroring must leave the others answered; the failure is carried in that key's value.",
      "input": [
        "1.1.1.1",
        "notanip"
      ],
      "expect": {
        "keys": [
          "1.1.1.1",
          "notanip"
        ],
        "errorKeys": [
          "notanip"
        ]
      }
    },
    {
      "name": "cache-hit-issues-no-second-request",
      "why": "The second batch over the same address is served entirely from the per-client cache.",
      "input": [
        "1.1.1.1"
      ],
      "repeat": 2,
      "expect": {
        "keys": [
          "1.1.1.1"
        ],
        "httpRequests": 1
      }
    }
  ],
