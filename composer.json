{
    "name": "vpndetection/vpndetection",
    "description": "Official PHP client library for the VPNDetection API. Detect VPNs, proxies, Tor, hosting and CDN IPs.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://vpndetection.io",
    "keywords": [
        "vpn",
        "vpn-detection",
        "proxy-detection",
        "tor",
        "ip-intelligence",
        "ip-geolocation",
        "fraud-prevention",
        "residential-proxy",
        "mobile-proxy",
        "datacenter-proxy",
        "hosting",
        "cdn",
        "relay"
    ],
    "authors": [
        {
            "name": "Mslm Dev",
            "homepage": "https://vpndetection.io"
        }
    ],
    "support": {
        "issues": "https://github.com/vpndetection-io/sdk-php/issues",
        "source": "https://github.com/vpndetection-io/sdk-php"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "composer-runtime-api": "^2.0",
        "guzzlehttp/guzzle": "^7.5 || ^8.0",
        "guzzlehttp/promises": "^2.0 || ^3.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "VPNDetection\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VPNDetection\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
