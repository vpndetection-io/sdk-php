{
    "name": "vpndetection/integration",
    "description": "Exercises the PUBLISHED vpndetection/vpndetection package against staging. Never published.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.5 || ^8.0",
        "vpndetection/vpndetection": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "VPNDetection\\Integration\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VPNDetection\\Integration\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
